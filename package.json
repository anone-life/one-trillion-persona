{
  "name": "one-trillion-persona",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "_desktop": "apps/desktop (the Electron shell) is not a workspace on purpose: npm install at the root would otherwise download Electron (~100 MB) for everyone. cd apps/desktop && npm install when you want it.",
  "scripts": {
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "1t": "node packages/cli/src/main.ts",
    "web": "npm --workspace @1t-persona/web run dev",
    "web:build": "npm --workspace @1t-persona/web run build",
    "desktop": "npm --prefix apps/desktop start"
  }
}
